#!/usr/bin/env bash
# ip
# Prints every local IPv4 address grouped by what it actually is --
# LAN, Tailscale, other VPN, VM bridge -- plus the public address.
# macOS ships no `ip(8)`, so this name is free.
# Colors follow the Catppuccin palette used by starship.toml.
set -uo pipefail

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  C_LAN=$'\033[38;2;166;227;161m'    # green
  C_TS=$'\033[38;2;203;166;247m'     # mauve
  C_VPN=$'\033[38;2;137;180;250m'    # blue
  C_VM=$'\033[38;2;108;112;134m'     # overlay/dim
  C_PUB=$'\033[1;38;2;250;179;135m'  # bold peach
  C_DIM=$'\033[38;2;88;91;112m'
  C_OFF=$'\033[0m'
else
  C_LAN= C_TS= C_VPN= C_VM= C_PUB= C_DIM= C_OFF=
fi

# One awk pass over both inputs: the hardware-port table names the physical
# interfaces (Wi-Fi vs Ethernet), ifconfig supplies the addresses.
{
  networksetup -listallhardwareports 2>/dev/null
  echo "===IFCONFIG==="
  ifconfig
} | awk -v lan="$C_LAN" -v ts="$C_TS" -v vpn="$C_VPN" -v vm="$C_VM" \
        -v dim="$C_DIM" -v off="$C_OFF" '
  function emit(color, icon, kind, iface, addr) {
    printf "%s%s  %-11s%s %s%-10s%s %s%s%s\n",
           color, icon, kind, off, dim, iface, off, color, addr, off
  }
  section == 1 && /^Hardware Port: / { p = substr($0, 16) }
  section == 1 && /^Device: /        { port[$2] = p }
  /^===IFCONFIG===$/                 { section = 2; next }
  section == 2 && /^[a-z]/           { iface = substr($1, 1, length($1) - 1) }
  section == 2 && /^\tinet / && $2 != "127.0.0.1" {
    addr = $2
    # Tailscale hands out 100.64.0.0/10 (CGNAT); other utun* are plain VPNs.
    if (addr ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./)
      emit(ts, "󰖂", "Tailscale", iface, addr)
    else if (iface ~ /^utun/)
      emit(vpn, "󰦝", "VPN", iface, addr)
    else if (iface ~ /^bridge/)
      emit(vm, "󰡨", "VM bridge", iface, addr)
    else if (port[iface] ~ /Wi-Fi/)
      emit(lan, "", "Wi-Fi", iface, addr)
    else
      emit(lan, "󰈀", "LAN", iface, addr)
  }
  BEGIN { section = 1 }
'

# Public: asked per family, since a v6-preferring network hides the v4 address.
# Several services in parallel: a dual-WAN / load-balanced network can exit
# through different ISPs per connection, so one service alone can mislead.
SERVICES=(ifconfig.me ipinfo.io/ip icanhazip.com api64.ipify.org ifconfig.co)
tmp=$(mktemp -d) && trap 'rm -rf "$tmp"' EXIT
for family in 4 6; do
  for svc in "${SERVICES[@]}"; do
    curl "-$family" -fsS --max-time 3 "https://$svc" 2>/dev/null \
      | tr -d '[:space:]' > "$tmp/$family-${svc%%/*}" &
  done
done
wait

for family in 4 6; do
  # macOS curl -6 can fall back to a v4-mapped address, so keep only real v6.
  [[ $family == 4 ]] && want='^[0-9.]+$' || want=':'
  # addr<TAB>svc,svc per distinct address
  rows=$(for svc in "${SERVICES[@]}"; do
           addr=$(<"$tmp/$family-${svc%%/*}")
           [[ $addr =~ $want ]] && printf '%s\t%s\n' "$addr" "${svc%%/*}"
         done | awk -F'\t' '{s[$1] = s[$1] ? s[$1] "," $2 : $2} END {for (a in s) print a "\t" s[a]}')
  [[ -z $rows ]] && rows=$'unavailable\t'
  n=$(wc -l <<<"$rows")
  while IFS=$'\t' read -r addr svcs; do
    note=$svcs
    (( n > 1 )) && note="$svcs  ⚠ services disagree (multi-WAN / proxy?)"
    printf "%s%s  %-11s%s %s%-10s%s %s%s%s %s%s%s\n" \
      "$C_PUB" "" "Public v$family" "$C_OFF" "$C_DIM" "" "$C_OFF" \
      "$C_PUB" "$addr" "$C_OFF" "$C_DIM" "$note" "$C_OFF"
  done <<<"$rows"
done

# A sticky multi-WAN shows only one exit at a time, so remember every public
# v4 seen behind this gateway and list the others too. Keyed by the gateway's
# MAC, not its IP: home and office routers can share 192.168.1.1-style IPs.
# Format: gateway-mac<TAB>addr<TAB>last-seen
hist=${XDG_CACHE_HOME:-$HOME/.cache}/ip-public.tsv
gw_ip=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
gw=$([[ -n $gw_ip ]] && arp -n "$gw_ip" 2>/dev/null | awk '$4 ~ /:/ {print $4}')
now_addrs=$(for svc in "${SERVICES[@]}"; do
              addr=$(<"$tmp/4-${svc%%/*}"); [[ $addr =~ ^[0-9.]+$ ]] && echo "$addr"
            done | sort -u)
if [[ -n $gw ]]; then
  mkdir -p "${hist%/*}" && touch "$hist"
  stamp=$(date '+%F %R')
  { cat "$hist"; while read -r a; do [[ -n $a ]] && printf '%s\t%s\t%s\n' "$gw" "$a" "$stamp"; done <<<"$now_addrs"; } \
    | awk -F'\t' '{last[$1 FS $2] = $3} END {for (k in last) print k FS last[k]}' | sort > "$hist.new" \
    && mv "$hist.new" "$hist"
  awk -F'\t' -v gw="$gw" '$1 == gw {print $2 "\t" $3}' "$hist" | while IFS=$'\t' read -r addr seen; do
    grep -qxF "$addr" <<<"$now_addrs" && continue
    printf "%s%s  %-11s%s %s%-10s%s %s%s%s %s%s%s\n" \
      "$C_DIM" "" "Also seen" "$C_OFF" "$C_DIM" "" "$C_OFF" \
      "$C_PUB" "$addr" "$C_OFF" "$C_DIM" "last $seen via gw $gw_ip" "$C_OFF"
  done
fi
